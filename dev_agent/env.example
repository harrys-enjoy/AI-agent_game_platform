# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 마세요.

# --- LLM ---
# supervisor 라우팅 + 워커(리뷰/엔드포인트/브랜치/CI 요약) 모두 이 Elice mlapi.run
# 엔드포인트 하나를 씁니다. 비워두면 graph/llm_client.py의 기본 URL을 씁니다 —
# Elice에서 엔드포인트를 재배포해 URL이 바뀌면 여기에 새 값을 채우세요.
ELICE_API_URL=https://mlapi.run/change-me
ELICE_API_KEY=change-me

# --- GitHub ---
# PR diff/브랜치 조회용. ci_trigger(워크플로 실행)까지 쓰려면 actions:write 권한 필요.
# 없으면 익명 접근(시간당 60회 제한)으로 동작합니다.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# kosa_front 대시보드가 기본으로 보여줄 레포. 비워두면 대시보드 설정 화면에서 직접 입력하거나
# mock 데이터로 대체됩니다. GITHUB_TOKEN을 재사용합니다.
GITHUB_OWNER=
GITHUB_REPO=

# ci_trigger가 워크플로 완료를 기다리는 최대 시간(초). 기본 600.
CI_TRIGGER_TIMEOUT_SEC=600

# --- A2A 서버 ---
# 오케스트레이터가 Authorization: Bearer 로 보내는 서비스 토큰. 임의의 긴 문자열로 생성하세요.
DEV_SERVICE_TOKEN=change-me-to-a-long-random-string

# workspace_id -> 레포 매핑. "팀id=owner/repo" 를 쉼표로 구분.
# 이게 워크스페이스가 접근할 수 있는 레포의 경계입니다.
WORKSPACE_REPO_MAP=game-team-a=dockersamples/todo-list-app

# main_agent(오케스트레이터)는 workspace_id를 안 보냅니다 — 요청에 workspace_id가 없으면
# 이 값을 대신 씁니다(위 WORKSPACE_REPO_MAP의 키 중 하나여야 함). 비워두면 workspace_id
# 없는 요청은 400으로 거절됩니다.
DEFAULT_WORKSPACE_ID=game-team-a

# --- 테스트 전용 스위치 ---
# true로 두면 위 레포 접근 제어를 완전히 해제하고, 요청 텍스트에 언급된
# 아무 GitHub 레포나 clone/build/run 합니다. deploy_trigger가 임의 코드를
# 실행하게 되므로 테스트가 끝나면 반드시 false로 되돌리세요.
REPO_ACCESS_CONTROL_DISABLED=false
