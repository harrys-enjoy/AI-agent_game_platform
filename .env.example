# Main Agent runtime
LIVE_AGENT_DISCOVERY=true
AGENT_REGISTRY=workmate-agent,video-agent,dev-agent,game-qna-agent

WORKMATE_AGENT_URL=http://workmate-agent:8001/a2a
VIDEO_AGENT_URL=http://video-agent:8002/a2a
DEV_AGENT_URL=http://dev-agent:8003/a2a
GAME_QNA_AGENT_URL=http://game-qa-agent:3000/message:send

# Optional server-side Bearer tokens. Never expose these to the frontend.
VIDEO_SERVICE_TOKEN=
DEV_SERVICE_TOKEN=
GAME_QNA_SERVICE_TOKEN=

# Shared by the main API and workmate-agent container.
WORKMATE_SERVICE_TOKEN=replace-with-a-local-service-token

# Optional Main routing LLM. When disabled or unavailable, keyword routing is used.
ROUTER_LLM_ENABLED=false
ROUTER_MODEL_NAME=
ROUTER_BASE_URL=https://integrate.api.nvidia.com/v1
ROUTER_API_KEY=
ROUTER_TIMEOUT_SECONDS=8

# Cat AI Chat can forward /api/ask requests to Main.
MAIN_AGENT_URL=http://main-agent:8000
