# Main Agent runtime
LIVE_AGENT_DISCOVERY=true
AGENT_REGISTRY=workmate-agent,video-agent,dev-agent,game-qna-agent

WORKMATE_AGENT_URL=http://workmate-agent:8001
VIDEO_AGENT_URL=http://video-agent:8002
DEV_AGENT_URL=http://dev-agent:8003
GAME_QNA_AGENT_URL=http://game-qa-agent:3000

# Optional server-side Bearer tokens. Never expose these to the frontend.
WORKMATE_AGENT_TOKEN=
VIDEO_AGENT_TOKEN=
DEV_AGENT_TOKEN=
GAME_QNA_AGENT_TOKEN=

# Shared by the main API and workmate-agent container.
WORKMATE_SERVICE_TOKEN=replace-with-a-local-service-token
